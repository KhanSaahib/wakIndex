{
  "_description": "Synthetic Claude settings with a hook and intentionally embedded credential markers.",
  "model": "claude-sonnet-5",
  "fallbackModel": ["claude-haiku-4-5"],
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "FIXTURE_LITERAL_DO_NOT_EMIT"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python ~/.claude/hooks/review_command.py --token FIXTURE_HOOK_TOKEN_DO_NOT_EMIT"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(~/work/**)",
      "Bash(git status)"
    ]
  }
}
